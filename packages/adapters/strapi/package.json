{
    "name": "dialectr-adapter-strapi",
    "version": "0.0.1",
    "description": "One query, every backend dialect. Zero-dependency query builder that compiles to lomkit, Strapi, PocketBase and more.",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/dialectr.git",
        "directory": "packages/adapters/strapi"
    },
    "homepage": "https://github.com/techmefr/dialectr#readme",
    "bugs": {
        "url": "https://github.com/techmefr/dialectr/issues"
    },
    "keywords": [
        "dialectr",
        "strapi",
        "query-builder",
        "filters"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run",
        "dev": "unbuild --stub"
    },
    "peerDependencies": {
        "dialectr": ">=0.0.1 <1"
    },
    "devDependencies": {
        "dialectr": "workspace:*",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5"
    }
}
